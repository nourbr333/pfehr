  <h2 class="subsection">4.3 Code Python — Extraction et Entraînement OKR</h2>
<pre><code># ── Extraction features OKR ──────────────────────────────────────────────
sql_okr = """
WITH members AS (
  SELECT tom.objective_id,
    COUNT(DISTINCT tom.employee_id)                                 AS nb_membres,
    AVG(CASE WHEN a.is_present=false
        AND a.attendance_date >= NOW()-INTERVAL '30 days'
        THEN 1.0 ELSE 0.0 END)                                      AS taux_abs_equipe_30j,
    SUM(CASE WHEN a.attendance_date=CURRENT_DATE
        AND a.is_present=false THEN 1 ELSE 0 END)                   AS absents_auj
  FROM team_objective_members tom
  LEFT JOIN attendance a ON tom.employee_id=a.employee_id
  GROUP BY tom.objective_id
),
milestones AS (
  SELECT objective_id,
    COUNT(CASE WHEN status='COMPLETED' THEN 1 END)::float /
      NULLIF(COUNT(*),0)                                            AS ratio_jalons
  FROM objective_milestones GROUP BY objective_id
),
updates AS (
  SELECT objective_id,
    COUNT(CASE WHEN updated_at >= NOW()-INTERVAL '30 days' THEN 1 END) AS nb_updates_30j,
    COALESCE(MAX(CASE WHEN updated_at >= NOW()-INTERVAL '30 days'
        THEN progress_value END) -
    MIN(CASE WHEN updated_at >= NOW()-INTERVAL '30 days'
        THEN progress_value END), 0)                                AS delta_progress_30j
  FROM objective_progress_updates GROUP BY objective_id
)
SELECT o.objective_id,
  o.progress_percentage                                             AS progress_actuel,
  COALESCE(m.ratio_jalons,0)         AS ratio_jalons_completes,
  GREATEST(0,
    EXTRACT(DAY FROM o.deadline-NOW())::float /
    NULLIF(EXTRACT(DAY FROM o.deadline-o.start_date),0))           AS jours_restants_ratio,
  COALESCE(mem.taux_abs_equipe_30j,0) AS taux_absence_equipe,
  COALESCE(upd.nb_updates_30j,0)     AS nb_updates_30j,
  COALESCE(upd.delta_progress_30j,0) AS delta_progress_30j,
  COALESCE(mem.nb_membres,1)         AS nb_membres,
  CASE WHEN o.progress_percentage &lt; 70 THEN 1 ELSE 0 END          AS target_non_atteint
FROM team_objectives o
LEFT JOIN milestones m   ON o.objective_id=m.objective_id
LEFT JOIN members   mem  ON o.objective_id=mem.objective_id
LEFT JOIN updates   upd  ON o.objective_id=upd.objective_id
WHERE o.deadline &lt; NOW()  -- entraînement sur objectifs terminés uniquement
"""

df_o = pd.read_sql(sql_okr, engine)
df_o.fillna(0, inplace=True)

FEATS_O = ["progress_actuel","ratio_jalons_completes","jours_restants_ratio",
           "taux_absence_equipe","nb_absents_auj","nb_updates_30j","delta_progress_30j",
           "nb_membres","has_action_plan","nb_dependances","manager_presence"]

X_o = df_o[FEATS_O]; y_o = df_o["target_non_atteint"]
X_tr_o, X_te_o, y_tr_o, y_te_o = train_test_split(X_o, y_o, test_size=0.2, random_state=42)

rf_o = RandomForestClassifier(n_estimators=100, random_state=42)
rf_o.fit(X_tr_o, y_tr_o)
print(f"OKR AUC : {roc_auc_score(y_te_o, rf_o.predict_proba(X_te_o)[:,1]):.3f}")

pd.Series(rf_o.feature_importances_, index=FEATS_O).sort_values().plot(
    kind="barh", color="purple", figsize=(8,5))
plt.title("Feature Importances — OKR Non-Atteinte")
plt.savefig("feat_imp_okr.png", dpi=150)
joblib.dump(rf_o, "model_okr.pkl")</code></pre>

