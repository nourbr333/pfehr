  <h3 class="sub3">Code Angular — RiskCardComponent (réutilisable pour les 3 prédictions)</h3>
<pre><code>// risk-card.component.ts
import { Component, Input } from "@angular/core";
import { CommonModule } from "@angular/common";

export interface PredictionResult {
  riskProba: number;         // 0.0 à 1.0
  riskLevel: "LOW" | "MEDIUM" | "HIGH";
  riskLabel: string;
  topFeatures?: { name: string; importance: number }[];
}

@Component({
  selector: "app-risk-card",
  standalone: true,
  imports: [CommonModule],
  template: `
    &lt;div class="risk-card" [class]="result.riskLevel.toLowerCase()"&gt;
      &lt;div class="risk-header"&gt;
        &lt;span class="risk-icon"&gt;
          {{ result.riskLevel === "HIGH" ? "🔴" :
             result.riskLevel === "MEDIUM" ? "🟡" : "🟢" }}
        &lt;/span&gt;
        &lt;span class="risk-title"&gt;{{ result.riskLabel }}&lt;/span&gt;
        &lt;span class="risk-badge {{ result.riskLevel.toLowerCase() }}"&gt;
          {{ result.riskLevel === "HIGH" ? "ÉLEVÉ" :
             result.riskLevel === "MEDIUM" ? "MOYEN" : "FAIBLE" }}
        &lt;/span&gt;
      &lt;/div&gt;
      &lt;div class="risk-score"&gt;{{ (result.riskProba * 100).toFixed(0) }}%&lt;/div&gt;
      &lt;div class="risk-bar-track"&gt;
        &lt;div class="risk-bar-fill {{ result.riskLevel.toLowerCase() }}"
             [style.width.%]="result.riskProba * 100"&gt;&lt;/div&gt;
      &lt;/div&gt;
      &lt;div class="risk-features" *ngIf="result.topFeatures"&gt;
        &lt;div *ngFor="let f of result.topFeatures" class="feature-row"&gt;
          &lt;span class="feat-name"&gt;{{ f.name }}&lt;/span&gt;
          &lt;div class="feat-bar"&gt;&lt;div [style.width.%]="f.importance * 100"&gt;&lt;/div&gt;&lt;/div&gt;
          &lt;span class="feat-pct"&gt;{{ (f.importance*100).toFixed(0) }}%&lt;/span&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;`
})
export class RiskCardComponent {
  @Input() result!: PredictionResult;
}</code></pre>


