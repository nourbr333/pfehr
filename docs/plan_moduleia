  <h2 class="subsection">6.1 DTO Unifié et Service Principal</h2>
<pre><code>// ── PredictionResponseDTO.java ────────────────────────────────────────────
package com.hranalytics.hrbackend.ia.dto;

public record PredictionResponseDTO(
    String  prediction,
    Integer subjectId,
    Double  riskProba,
    String  riskLevel,    // "LOW" | "MEDIUM" | "HIGH"
    String  riskLabel
) {}

// ── PredictionService.java ────────────────────────────────────────────────
package com.hranalytics.hrbackend.ia.service;

@Service
public class PredictionService {
    private final RestTemplate rest = new RestTemplate();
    private static final String FLASK = "http://localhost:5001/predict";

    // ── P1 : Absentéisme ─────────────────────────────────────────────
    public PredictionResponseDTO predictAbsenteisme(Integer empId) {
        List&lt;Double&gt; features = List.of(
            attRepo.calcTauxAbsence(empId, 30),
            attRepo.calcTauxAbsence(empId, 90),
            (double) attRepo.countRetards(empId, 30),
            attRepo.avgOvertime(empId, 30),
            (double) absRepo.countByType(empId, "maladie", 12),
            (double) absRepo.countByStatus(empId, "APPROVED", 12),
            (double) absRepo.countByStatus(empId, "REJECTED", 12),
            attRepo.calcDeptTaux(empId),
            empRepo.calcAnciennete(empId),
            empRepo.calcAge(empId)
        );
        return callFlask("/absenteisme", empId, features, "employee_id");
    }

    // ── P2 : Burnout ──────────────────────────────────────────────────
    public PredictionResponseDTO predictBurnout(Integer empId) {
        List&lt;Double&gt; features = List.of(
            attRepo.avgOvertime(empId, 60),
            attRepo.maxOvertime(empId, 60),
            attRepo.calcTauxAbsence(empId, 60),
            (double) attRepo.countRetards(empId, 60),
            (double) attRepo.countWeekendPresences(empId, 60),
            (double) absRepo.countByType(empId, "maladie", 2),
            (double) absRepo.countRefusesDays(empId, 60),
            absRepo.avgDurationRefused(empId),
            evalRepo.getLastRating(empId),
            evalRepo.getDeltaRating(empId),
            attRepo.calcDeptOvertimeMoyen(empId),
            empRepo.calcAnciennete(empId)
        );
        return callFlask("/burnout", empId, features, "employee_id");
    }

    // ── P3 : OKR ──────────────────────────────────────────────────────
    public PredictionResponseDTO predictOkr(Long objId) {
        List&lt;Double&gt; features = List.of(
            okrRepo.getProgress(objId),
            okrRepo.getRatioJalons(objId),
            okrRepo.getJoursRestantsRatio(objId),
            attRepo.calcTeamTaux(objId, 30),
            (double) attRepo.countTeamAbsentToday(objId),
            (double) okrRepo.countUpdates(objId, 30),
            okrRepo.getDeltaProgress(objId, 30),
            (double) okrRepo.countMembers(objId),
            okrRepo.hasActionPlan(objId) ? 1.0 : 0.0,
            (double) okrRepo.countDependances(objId),
            attRepo.getManagerPresence(objId)
        );
        return callFlask("/okr", objId.intValue(), features, "objective_id");
    }

    // ── Appel générique Flask ──────────────────────────────────────────
    private PredictionResponseDTO callFlask(
            String endpoint, Integer id,
            List&lt;Double&gt; features, String idKey) {
        try {
            Map&lt;String, Object&gt; body = new HashMap&lt;&gt;();
            body.put(idKey, id);
            body.put("features", features);
            return rest.postForObject(FLASK + endpoint, body, PredictionResponseDTO.class);
        } catch (Exception e) {
            return new PredictionResponseDTO(
                "unavailable", id, null, "UNKNOWN",
                "Prédiction indisponible — service IA hors ligne");
        }
    }
}</code></pre>

  <h2 class="subsection">6.2 Controller REST</h2>
<pre><code>// PredictionController.java
@RestController
@RequestMapping("/api/predictions")
@CrossOrigin(originPatterns = {"http://localhost:*"})
public class PredictionController {
    private final PredictionService svc;

    // GET /api/predictions/absenteisme/{employeeId}
    @GetMapping("/absenteisme/{employeeId}")
    public ResponseEntity&lt;PredictionResponseDTO&gt; absenceRisk(
            @PathVariable Integer employeeId) {
        return ResponseEntity.ok(svc.predictAbsenteisme(employeeId));
    }

    // GET /api/predictions/burnout/{employeeId}
    @GetMapping("/burnout/{employeeId}")
    public ResponseEntity&lt;PredictionResponseDTO&gt; burnoutRisk(
            @PathVariable Integer employeeId) {
        return ResponseEntity.ok(svc.predictBurnout(employeeId));
    }

    // GET /api/predictions/okr/{objectiveId}
    @GetMapping("/okr/{objectiveId}")
    public ResponseEntity&lt;PredictionResponseDTO&gt; okrRisk(
            @PathVariable Long objectiveId) {
        return ResponseEntity.ok(svc.predictOkr(objectiveId));
    }

    // GET /api/predictions/employee/{id}/all — les 2 scores employé en un seul appel
    @GetMapping("/employee/{employeeId}/all")
    public ResponseEntity&lt;Map&lt;String, PredictionResponseDTO&gt;&gt; allRisks(
            @PathVariable Integer employeeId) {
        return ResponseEntity.ok(Map.of(
            "absenteisme", svc.predictAbsenteisme(employeeId),
            "burnout",     svc.predictBurnout(employeeId)
        ));
    }
}</code></pre>


