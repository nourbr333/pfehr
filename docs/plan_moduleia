  <h1 class="section">5. Microservice Flask — Code Complet</h1>
  <p>Un seul fichier Python (~80 lignes). Charge les 3 modèles au démarrage, expose 4 endpoints (3 prédictions + health check).</p>

<pre><code># app.py — Microservice Flask unifié
from flask import Flask, request, jsonify
import joblib, numpy as np, os
from functools import wraps

app = Flask(__name__)

# ── Chargement des modèles au démarrage ──────────────────────────────────
MODEL_DIR = os.getenv("MODEL_DIR", "./models")
try:
    model_abs  = joblib.load(f"{MODEL_DIR}/model_absenteisme.pkl")
    scaler_abs = joblib.load(f"{MODEL_DIR}/scaler_absenteisme.pkl")
    model_burn = joblib.load(f"{MODEL_DIR}/model_burnout.pkl")
    model_okr  = joblib.load(f"{MODEL_DIR}/model_okr.pkl")
    print("[FLASK] Tous les modèles chargés avec succès.")
except FileNotFoundError as e:
    print(f"[FLASK] ERREUR chargement modèle : {e}")
    raise

# ── Utilitaires ──────────────────────────────────────────────────────────
def risk_level(proba: float) -> str:
    if proba >= 0.65: return "HIGH"
    if proba >= 0.35: return "MEDIUM"
    return "LOW"

def risk_label_fr(level: str) -> str:
    return {"HIGH":"Risque Élevé","MEDIUM":"Risque Moyen","LOW":"Risque Faible"}[level]

def validate_payload(f):
    @wraps(f)
    def wrapper(*args, **kwargs):
        data = request.get_json(silent=True)
        if not data or "features" not in data:
            return jsonify({"error":"Payload invalide. Clé 'features' manquante."}), 400
        return f(data, *args, **kwargs)
    return wrapper

# ── Endpoint 1 : Risque Absentéisme ─────────────────────────────────────
@app.route("/predict/absenteisme", methods=["POST"])
@validate_payload
def predict_absenteisme(data):
    try:
        X = np.array([data["features"]], dtype=float)
        X_s = scaler_abs.transform(X)
        proba = float(model_abs.predict_proba(X_s)[0][1])
        level = risk_level(proba)
        return jsonify({
            "prediction":  "absenteisme",
            "employee_id": data.get("employee_id"),
            "risk_proba":  round(proba, 3),
            "risk_level":  level,
            "risk_label":  f"Risque Absentéisme — {risk_label_fr(level)}",
            "threshold":   {"HIGH": 0.65, "MEDIUM": 0.35}
        })
    except Exception as e:
        return jsonify({"error": str(e)}), 500

# ── Endpoint 2 : Risque Burnout ──────────────────────────────────────────
@app.route("/predict/burnout", methods=["POST"])
@validate_payload
def predict_burnout(data):
    try:
        X = np.array([data["features"]], dtype=float)
        proba = float(model_burn.predict_proba(X)[0][1])
        level = risk_level(proba)
        return jsonify({
            "prediction":  "burnout",
            "employee_id": data.get("employee_id"),
            "risk_proba":  round(proba, 3),
            "risk_level":  level,
            "risk_label":  f"Risque Burnout — {risk_label_fr(level)}"
        })
    except Exception as e:
        return jsonify({"error": str(e)}), 500

# ── Endpoint 3 : Risque Non-Atteinte OKR ────────────────────────────────
@app.route("/predict/okr", methods=["POST"])
@validate_payload
def predict_okr(data):
    try:
        X = np.array([data["features"]], dtype=float)
        proba = float(model_okr.predict_proba(X)[0][1])
        level = risk_level(proba)
        return jsonify({
            "prediction":   "okr_risk",
            "objective_id": data.get("objective_id"),
            "risk_proba":   round(proba, 3),
            "risk_level":   level,
            "risk_label":   f"Risque Non-Atteinte OKR — {risk_label_fr(level)}"
        })
    except Exception as e:
        return jsonify({"error": str(e)}), 500

# ── Health check ─────────────────────────────────────────────────────────
@app.route("/health")
def health():
    return jsonify({"status":"ok","models_loaded":3,"version":"1.0.0"})

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5001, debug=False)</code></pre>

