  <h2 class="subsection">3.3 Code Python — Extraction Features Burnout</h2>
<pre><code># ── Extraction features Burnout ──────────────────────────────────────────
sql_burnout = """
WITH att60 AS (
  SELECT employee_id,
    AVG(overtime_hours)                                             AS ot_moyen_60j,
    MAX(overtime_hours)                                             AS ot_max,
    COUNT(CASE WHEN is_present=false THEN 1 END)::float/
      NULLIF(COUNT(*),0)                                            AS taux_abs_60j,
    COUNT(CASE WHEN is_late=true THEN 1 END)                        AS nb_retards_60j,
    COUNT(CASE WHEN EXTRACT(DOW FROM attendance_date) IN (0,6)
         AND is_present=true THEN 1 END)                            AS nb_weekend
  FROM attendance
  WHERE attendance_date >= NOW()-INTERVAL '60 days'
  GROUP BY employee_id
),
ab60 AS (
  SELECT employee_id,
    COUNT(CASE WHEN absence_type='maladie' THEN 1 END)             AS nb_maladie_60j,
    COUNT(CASE WHEN status='REJECTED' THEN 1 END)                   AS nb_refuses_60j,
    COALESCE(AVG(CASE WHEN status='REJECTED'
        THEN EXTRACT(DAY FROM end_date-start_date) END),0)          AS duree_moy_ref
  FROM absence_requests
  WHERE start_date >= NOW()-INTERVAL '60 days'
  GROUP BY employee_id
),
eval_data AS (
  SELECT employee_id,
    FIRST_VALUE(rating) OVER(PARTITION BY employee_id ORDER BY evaluated_at DESC) AS last_note,
    FIRST_VALUE(rating) OVER(PARTITION BY employee_id ORDER BY evaluated_at DESC) -
    NTH_VALUE(rating,2) OVER(PARTITION BY employee_id ORDER BY evaluated_at DESC
      ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)     AS delta_note
  FROM employee_evaluations
)
SELECT e.employee_id,
  COALESCE(a.ot_moyen_60j,0)   AS overtime_moyen_60j,
  COALESCE(a.ot_max,0)         AS overtime_max,
  COALESCE(a.taux_abs_60j,0)   AS taux_absence_60j,
  COALESCE(a.nb_retards_60j,0) AS nb_retards_60j,
  COALESCE(a.nb_weekend,0)     AS nb_weekend_presents,
  COALESCE(b.nb_maladie_60j,0) AS nb_maladie_60j,
  COALESCE(b.nb_refuses_60j,0) AS nb_refuses_60j,
  COALESCE(b.duree_moy_ref,0)  AS duree_moy_refuses,
  COALESCE(ev.last_note,3)     AS derniere_note,
  COALESCE(ev.delta_note,0)    AS delta_note,
  EXTRACT(YEAR FROM AGE(NOW(),e.hire_date)) AS anciennete
FROM employees e
LEFT JOIN att60 a   ON e.employee_id=a.employee_id
LEFT JOIN ab60 b    ON e.employee_id=b.employee_id
LEFT JOIN eval_data ev ON e.employee_id=ev.employee_id
"""

df_b = pd.read_sql(sql_burnout, engine)
df_b.fillna(0, inplace=True)

# Générer la target par règle des 3 signaux
sig1 = ((df_b.overtime_moyen_60j > 2) | (df_b.nb_weekend_presents > 4)).astype(int)
sig2 = ((df_b.taux_absence_60j > 0.15) | (df_b.nb_retards_60j > 6)).astype(int)
sig3 = ((df_b.nb_maladie_60j >= 2) | (df_b.delta_note < -1)).astype(int)
df_b["target_burnout"] = ((sig1+sig2+sig3) >= 2).astype(int)

FEATS_B = ["overtime_moyen_60j","overtime_max","taux_absence_60j","nb_retards_60j",
           "nb_weekend_presents","nb_maladie_60j","nb_refuses_60j","duree_moy_refuses",
           "derniere_note","delta_note","dept_overtime_moyen","anciennete"]

X_b = df_b[FEATS_B]; y_b = df_b["target_burnout"]
X_tr_b, X_te_b, y_tr_b, y_te_b = train_test_split(X_b, y_b, test_size=0.2, random_state=42)

rf_b = RandomForestClassifier(n_estimators=100, random_state=42)
rf_b.fit(X_tr_b, y_tr_b)
print(classification_report(y_te_b, rf_b.predict(X_te_b)))

# Arbre de décision visualisable (pour soutenance)
from sklearn.tree import DecisionTreeClassifier, export_text
dt = DecisionTreeClassifier(max_depth=4, random_state=42)
dt.fit(X_tr_b, y_tr_b)
print(export_text(dt, feature_names=FEATS_B))

joblib.dump(rf_b, "model_burnout.pkl")</code></pre>

