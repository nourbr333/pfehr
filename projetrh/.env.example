# Copier ce fichier en .env à la racine de projetrh/ et adapter les valeurs.
# Le fichier .env n'est pas versionné (voir .gitignore).

# Profil Spring : dev (local) ou prod (déploiement)
SPRING_PROFILES_ACTIVE=dev

# Base de données PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/hr_database
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# JWT — clé secrète Base64 (256 bits minimum)
# Générer avec : openssl rand -base64 32
JWT_SECRET=your_base64_jwt_secret_here
JWT_EXPIRATION=28800000

# Active Directory (SSO)
AD_DOMAIN=EMEAAD
AD_URL=ldap://emeaad/
